{
  "name": "cancha-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:connection": "node scripts/check-connection.mjs",
    "check:network": "node scripts/check-network.mjs",
    "test": "node --test",
    "start:submissions": "node server/submissions.mjs",
    "render:instagram": "node scripts/render-instagram.mjs",
    "content:import": "node scripts/instagram.mjs import content/instagram/drafts.json",
    "content:list": "node scripts/instagram.mjs list",
    "content:due": "node scripts/instagram.mjs due",
    "offers:check": "node scripts/hide-expired-offers.mjs --dry-run",
    "review:published": "node scripts/review-published.mjs",
    "opportunities:daily": "node scripts/daily-opportunities.mjs",
    "opportunities:cleanup": "node scripts/daily-opportunities.mjs --apply-statuses",
    "opportunities:stage": "node scripts/stage-opportunities.mjs",
    "opportunities:prepare": "node scripts/prepare-opportunities.mjs",
    "opportunities:automate": "node scripts/automate-opportunities.mjs",
    "automation:status": "node scripts/check-automation-status.mjs",
    "instagram:chat": "node scripts/chat-instagram.mjs",
    "instagram:github": "node scripts/github-instagram.mjs",
    "content:photos": "node scripts/build-photo-editorial.mjs",
    "content:video": "node video/render-community-cut.mjs",
    "content:voice-setup": "node video/audio/setup.mjs",
    "content:motion": "node video/render-motion.mjs",
    "content:explainer": "node video/render-explainer.mjs",
    "content:voice-check": "node scripts/premium-voice.mjs check",
    "content:voice-audition": "node scripts/premium-voice.mjs audition",
    "content:club-cut": "node video/render-club-cut.mjs",
    "content:free-setup": "node scripts/free-content-tools.mjs setup",
    "content:free-voice": "node scripts/free-content-tools.mjs audition",
    "content:captions": "node scripts/free-content-tools.mjs transcribe",
    "content:single-story": "node video/render-single-story.mjs",
    "content:story-voice": "node scripts/free-content-tools.mjs story",
    "content:story-media": "node scripts/prepare-single-story.mjs",
    "content:story-share": "node scripts/share-single-story.mjs",
    "content:eleven-free-audition": "node scripts/premium-voice.mjs free-audition",
    "content:products": "node scripts/build-product-editorial.mjs",
    "content:narrative": "node video/render-narrative-story.mjs",
    "content:narrative-share": "node scripts/share-narrative-story.mjs"
  },
  "dependencies": {
    "framer-api": "5.1.0",
    "https-proxy-agent": "9.1.0",
    "linkedom": "0.18.12",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "undici": "8.1.0"
  }
}
