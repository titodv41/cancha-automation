{
  "enabled": true,
  "includedUsageConfirmed": true,
  "repository": "titodv41/cancha-automation",
  "timezone": "America/New_York",
  "authentication": "claude-pro-oauth-only",
  "model": "sonnet",
  "maximumInitialRunsPerWeek": 2,
  "maximumInitialRunsPerDay": 1,
  "maximumRevisionsPerPullRequest": 1,
  "initialTurns": 15,
  "revisionTurns": 8,
  "timeoutMinutes": 25,
  "maximumOutputTokens": 16000,
  "maximumChangedFiles": 3,
  "maximumEdits": 8,
  "maximumEditCharacters": 24000,
  "maximumChangedLines": 300,
  "branchPrefix": "claude/cancha-improve-",
  "codexReviewers": [
    "chatgpt-codex-connector[bot]",
    "chatgpt-codex-connector"
  ],
  "allowedPaths": [
    "framer/CanchaHome.tsx",
    "framer/CanchaDiscovery.tsx",
    "framer/CanchaDetail.tsx",
    "video/src/AutomaticNewsStory.tsx",
    "scripts/photo-card-layout.mjs",
    "scripts/photo-panel-layout.mjs"
  ],
  "automaticMerge": false,
  "automaticProductionRelease": false,
  "automaticWorkflowRetry": false,
  "maximumRevisionsPerWeek": 2
}
