[{"src": [0, 1.829], "speechAt": 0.0, "text": "New in Miami, and no team?"}, {"src": [2.673, 3.678], "speechAt": 2.11, "text": "There are three ways in."}, {"src": [4.094, 4.549], "speechAt": 3.32, "text": "One:"}, {"src": [5.001, 8.042], "speechAt": 3.78, "text": "Rec leagues let you sign up solo, and they put you on a team."}, {"src": [8.431, 8.901], "speechAt": 7.03, "text": "Two:"}, {"src": [9.285, 12.822], "speechAt": 7.51, "text": "Clubs post their tryouts on Instagram, so follow the clubs near you."}, {"src": [13.232, 13.714], "speechAt": 11.26, "text": "Three:"}, {"src": [14.176, 17.611], "speechAt": 11.75, "text": "Tell Cancha what you play, and we'll find you a club that fits."}, {"src": [17.801, 18.788], "speechAt": 15.45, "text": "Find me a team."}, {"src": [19.033, 99], "speechAt": 16.5, "text": "Link in bio."}]